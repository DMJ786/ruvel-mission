{
  "name": "ruvel-mission",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "concurrently -k -n MISSION,BRIGHTENERGY,CIVICAID,NEXTSTEP -c cyan,green,blue,magenta \"pnpm --filter @ruvel/mission-hub dev\" \"pnpm --filter @ruvel/brightenergy dev\" \"pnpm --filter @ruvel/civicaid dev\" \"pnpm --filter @ruvel/nextstep dev\"",
    "lint": "eslint .",
    "test": "vitest run packages/spike-core/tests/index.test.ts packages/mission-core/tests/phase1.test.ts packages/mission-core/tests/phase2.test.ts packages/mission-core/tests/phase3.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
